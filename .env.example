# ============================================================
# Taxfello – Environment Variables Template
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
# Add production values directly in Vercel → Project → Settings
# → Environment Variables.
# ============================================================

# -- SMTP (Gmail SMTP + Google App Password) ------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@taxfello.com
SMTP_PASSWORD=your_google_app_password_here

# -- Email addresses ------------------------------------------
MAIL_FROM=support@taxfello.com
MAIL_BCC=brandbanalo25@gmail.com
